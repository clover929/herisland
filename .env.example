AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# demo keeps all existing local features; supabase enables real SSR Auth.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, reserved for an offline operator/import worker. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
# Future cloud AI adapter; not implemented or enabled by these placeholders.
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# OPTIONAL staging-only real integration tests; never use production keys here.
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Read-only project-name verification before staging integration writes.
SUPABASE_ACCESS_TOKEN=
SUPABASE_TEST_EXPECTED_PROJECT_REF=
